config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	update_context(update_context)
	detect_states(detect_states)
	judge_states(judge_states)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> update_context;
	detect_states -. &nbsp;skip&nbsp; .-> finalize;
	detect_states -. &nbsp;judge&nbsp; .-> judge_states;
	judge_states --> finalize;
	update_context --> detect_states;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
